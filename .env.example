# Initial backend to target. ONLY THE PORT IS READ — the host is derived at runtime from the
# host the app was loaded from (localhost on the dev machine, 192.168.0.254 from a phone on
# the LAN), so a `localhost` value here does NOT pin requests to localhost.
# Backend ports across the pokedex ecosystem: .NET 5257 | JS (Express) 3000 | TS (Express) 3001
# Precedence: persisted switcher choice (localStorage `pokedex.apiTarget`) > this > .NET (5257).
VITE_API_BASE_URL=http://localhost:5257
